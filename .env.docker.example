# ===========================================================================
# FiberTrack Pro - self-hosting configuration
# Copy this file to .env  (in the same folder as docker-compose.yml)
#   cp .env.docker.example .env
# then edit the values below.
# ===========================================================================

# --- PostgreSQL (used by the bundled db service) ---
POSTGRES_USER=fibertrack
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=fibertrack

# --- Authentication (REQUIRED) ---
# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_openssl_rand_base64_32
# Usually the same value as NEXTAUTH_SECRET; leave blank to reuse it.
AUTH_SECRET=
# The public URL the app is served from.
#   local test:   http://localhost:3000
#   production:    https://fibertrack.yourdomain.com
NEXTAUTH_URL=http://localhost:3000

# --- Host port to expose the app on ---
APP_PORT=3000

# --- Seed REFERENCE/config data on first start (NO user accounts are created) ---
# The seed is account-free: it only inserts idempotent reference/config rows.
# Create the first admin via the app's first-run setup after the stack is up.
# Leave false unless you specifically want the reference data reseeded.
SEED_ON_START=false

# --- File storage for photos & documents (S3-compatible) ---
# Required for the photo/document upload features to work.
# Use your own AWS S3 bucket (or any S3-compatible service) and an IAM key
# that can put/get/delete objects in the bucket.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
# Optional key prefix inside the bucket, e.g. fibertrack/ (include trailing slash)
AWS_FOLDER_PREFIX=

# --- Credential encryption key (REQUIRED for the email/SMTP feature) ---
# Encrypts the SMTP password before it is stored in the database (AES-256-GCM).
# Generate ONCE and keep it safe & BACKED UP - if you lose it you must re-enter
# the SMTP password in Settings. Rotating it also requires re-entering SMTP creds.
# Generate with:  openssl rand -base64 32
# Store it OUTSIDE source control (never commit a real value). See docs/MIGRATIONS.md.
APP_ENCRYPTION_KEY=

# --- Outgoing email / SMTP ---
# There is NOTHING to set here. All SMTP settings (host, port, username, from
# address, and the password) are configured in the app UI at Settings -> Email
# by an Admin after first start, and the password is stored encrypted in the
# database using APP_ENCRYPTION_KEY above. Setting APP_ENCRYPTION_KEY is the only
# requirement to enable the email feature.
