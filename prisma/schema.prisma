generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/fibertrack_pro/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PROJECT_MANAGER
  FIELD_WORKER
  SALES
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
  LOCKED
}

enum JobStatus {
  DRAFT
  ACTIVE
  IN_PROGRESS
  UNDER_REVIEW
  APPROVED
  INVOICED
  CLOSED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
}

enum ActivityType {
  PHOTO
  DOCUMENT
  NOTE
  STATUS_UPDATE
  CHECK_IN
}

enum WorkerType {
  SUBCONTRACTOR
  IN_HOUSE
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

enum PriceBookStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PriceImportStatus {
  PENDING
  APPROVED
  CANCELLED
}

enum RateStatus {
  ACTIVE
  ARCHIVED
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  passwordHash   String
  role           UserRole  @default(FIELD_WORKER)
  status              UserStatus @default(ACTIVE)
  forcePasswordChange Boolean    @default(false)
  tokenVersion        Int        @default(0)
  deactivatedAt       DateTime?
  lastLoginAt         DateTime?
  mfaEnabled          Boolean    @default(false)
  mfaSecret           String?
  mfaEnrolledAt       DateTime?
  mfaLastVerifiedAt   DateTime?
  workerId       String?   @unique
  worker         Worker?   @relation(fields: [workerId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  accounts       Account[]
  sessions       Session[]
  mfaRecoveryCodes MfaRecoveryCode[]
  mobileDevices  MobileDevice[]
  mobileSessions MobileSession[]

  @@index([email])
  @@index([status])
}

model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model MfaPolicy {
  role      UserRole @id
  required  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PrimeContractor {
  id           String   @id @default(cuid())
  companyName  String
  contactName  String?
  email        String?
  phone        String?
  address      String?
  city         String?
  state        String?
  zip          String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  rateCards    PrimeContractorRate[]
  jobs         Job[]
  invoices     Invoice[]
  priceBooks   PriceBook[]
  priceImports PriceImport[]
  payments       Payment[]
  paymentMethods PaymentMethod[]
}

model TaskType {
  id            String   @id @default(cuid())
  name          String   @unique
  description   String?
  unitOfMeasure String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  primeRates    PrimeContractorRate[]
  workerRates   WorkerRate[]
  tasks         Task[]
}

model PrimeContractorRate {
  id                String          @id @default(cuid())
  primeContractorId String
  taskTypeId        String
  ratePerUnit       Int             // cents
  primeContractor   PrimeContractor @relation(fields: [primeContractorId], references: [id], onDelete: Cascade)
  taskType          TaskType        @relation(fields: [taskTypeId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([primeContractorId, taskTypeId])
}

model Worker {
  id           String     @id @default(cuid())
  name         String
  workerType   WorkerType
  email        String?
  phone        String?
  companyName  String?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User?
  rates        WorkerRate[]
  tasks        Task[]
  activityLogs ActivityLog[]
  payoutRecords PayoutRecord[]
  subcontractorRates SubcontractorRate[]
  crewId       String?
  crew         Crew?      @relation(fields: [crewId], references: [id])
  assignedVehicles FleetVehicle[]
  locations    WorkerLocation[]
  geoEvents    GeoEvent[]
  devices          MobileDevice[]
  mobileSessions   MobileSession[]
  evidencePackages FieldEvidencePackage[]

  @@index([crewId])
}

model WorkerRate {
  id          String   @id @default(cuid())
  workerId    String
  taskTypeId  String
  ratePerUnit Int      // cents
  worker      Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  taskType    TaskType @relation(fields: [taskTypeId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workerId, taskTypeId])
}

model Job {
  id                String          @id @default(cuid())
  jobNumber         String          @unique
  jobName           String
  primeContractorId String
  address           String?
  city              String?
  state             String?
  zip               String?
  latitude          Float?
  longitude         Float?
  startDate         DateTime?
  dueDate           DateTime?
  status            JobStatus       @default(DRAFT)
  notes             String?
  otherDirectCosts  Int             @default(0) // cents; manual non-labor direct costs
  salespersonId     String?
  commissionPlanId  String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  primeContractor   PrimeContractor @relation(fields: [primeContractorId], references: [id])
  salesperson       Salesperson?    @relation(fields: [salespersonId], references: [id])
  commissionPlan    CommissionPlan? @relation(fields: [commissionPlanId], references: [id])
  commissionRecords CommissionRecord[]
  tasks             Task[]
  activityLogs      ActivityLog[]
  geofenceRadiusFeet Int?           // per-job geofence override (feet); default in code
  currentVehicles   FleetVehicle[]
  vehicleTelemetry  VehicleTelemetry[]
  workerLocations   WorkerLocation[]
  geoEvents         GeoEvent[]
  evidencePackages  FieldEvidencePackage[]

  @@index([status])
  @@index([primeContractorId])
  @@index([salespersonId])
}

model Task {
  id              String     @id @default(cuid())
  jobId           String
  taskTypeId      String
  description     String?
  quantity        Float      @default(0)
  billingRate     Int        @default(0) // cents per unit
  workerPayoutRate Int       @default(0) // cents per unit
  workerId        String?
  status          TaskStatus @default(PENDING)
  billableAmount  Int        @default(0) // cents
  costAmount      Int        @default(0) // cents
  profitAmount    Int        @default(0) // cents
  invoiceItemId   String?
  payoutRecordId  String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  job             Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  taskType        TaskType   @relation(fields: [taskTypeId], references: [id])
  worker          Worker?    @relation(fields: [workerId], references: [id])
  invoiceItem     InvoiceItem? @relation(fields: [invoiceItemId], references: [id])
  payoutRecord    PayoutRecord? @relation(fields: [payoutRecordId], references: [id])
  activityLogs    ActivityLog[]
  evidencePackages FieldEvidencePackage[]

  @@index([jobId])
  @@index([workerId])
  @@index([status])
}

model ActivityLog {
  id               String       @id @default(cuid())
  jobId            String?
  taskId           String?
  workerId         String?
  activityType     ActivityType
  description      String?
  cloudStoragePath String?
  isPublic         Boolean      @default(false)
  contentType      String?
  fileName         String?
  latitude         Float?
  longitude        Float?
  gpsAccuracy      Float?
  distanceFromJob  Float?       // in feet
  proximityWarning Boolean      @default(false)
  createdAt        DateTime     @default(now())
  job              Job?         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  task             Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  worker           Worker?      @relation(fields: [workerId], references: [id])

  @@index([jobId])
  @@index([taskId])
  @@index([workerId])
  @@index([createdAt])
}

model Invoice {
  id                String          @id @default(cuid())
  invoiceNumber     String          @unique
  primeContractorId String
  subtotal          Int             @default(0) // cents
  taxRate           Float           @default(0)
  taxAmount         Int             @default(0) // cents
  total             Int             @default(0) // cents
  status            InvoiceStatus   @default(DRAFT)
  notes             String?
  lastEmailedAt     DateTime?
  emailCount        Int             @default(0)
  amountPaid        Int             @default(0) // cents; sum of PAID payments
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  primeContractor   PrimeContractor @relation(fields: [primeContractorId], references: [id])
  items             InvoiceItem[]
  payments          Payment[]

  @@index([primeContractorId])
  @@index([status])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float
  unitPrice   Int     // cents
  amount      Int     // cents
  jobId       String?
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tasks       Task[]
}

model PayoutRecord {
  id         String       @id @default(cuid())
  workerId   String
  totalAmount Int         @default(0) // cents
  status     PayoutStatus @default(PENDING)
  notes      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  worker     Worker       @relation(fields: [workerId], references: [id])
  tasks      Task[]

  @@index([workerId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Phase 1 (v1.1.0) foundations: branding, email, email templates/logs, audit.
// All tables are additive; no existing model semantics change.
// ---------------------------------------------------------------------------

// Single-company branding / white-label profile (singleton row id = "default").
// Multi-tenant branding is intentionally deferred; this model can later gain a
// tenantId without altering existing columns.
model CompanyProfile {
  id            String   @id @default("default")
  companyName   String   @default("OS1 Fiber Track Pro")
  legalName     String?
  tagline       String?  @default("Fiber Construction Services")
  logoUrl       String?
  logoStoragePath String?
  logoContentType String?
  address       String?
  city          String?
  state         String?
  zip           String?
  phone         String?
  email         String?
  website       String?
  supportEmail  String?
  supportPhone  String?
  primaryColor  String   @default("#1e40af")
  accentColor   String   @default("#0891b2")
  invoicePrefix String?  @default("INV")
  invoiceFooter String?  @default("Thank you for your business")
  portalUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// SMTP / email provider configuration (singleton row id = "default").
// The SMTP password is stored ONLY as AES-256-GCM ciphertext produced with
// APP_ENCRYPTION_KEY. There is no plaintext fallback; if the key is missing or
// wrong, decryption fails closed and email sending is disabled.
model EmailSettings {
  id                String   @id @default("default")
  enabled           Boolean  @default(false)
  host              String?
  port              Int?     @default(587)
  secure            Boolean  @default(false)
  username          String?
  passwordEncrypted String?
  fromName          String?
  fromEmail         String?
  replyTo           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Editable email templates. Bodies use an allow-listed {{variable}} syntax only;
// no arbitrary code execution is possible during rendering.
model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  subject   String
  bodyHtml  String
  bodyText  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Delivery log for every outbound email attempt.
model EmailLog {
  id          String      @id @default(cuid())
  toAddress   String
  ccAddress   String?
  subject     String
  templateKey String?
  status      EmailStatus @default(QUEUED)
  error       String?
  provider    String?
  messageId   String?
  relatedType String?
  relatedId   String?
  sentById    String?
  createdAt   DateTime    @default(now())
  sentAt      DateTime?

  @@index([relatedType, relatedId])
  @@index([status])
  @@index([createdAt])
}

// General-purpose audit trail for privileged/config actions (branding, email
// settings, invoice sends, etc.). Distinct from ActivityLog, which records field
// work (photos, notes, GPS). Expanded in Phase 2 for user lifecycle & MFA.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  actorRole  String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// Workstreams G/H/I/J: Prime Contractor Price Books, imports, and rate books.
// Price Book rate = WHAT THE PRIME CONTRACTOR PAYS US (billing). Never mixed
// with subcontractor payout or in-house cost. Rates are versioned: importing new
// rates creates a new version; historical price books/rates are never overwritten.
// -----------------------------------------------------------------------------

model PriceBook {
  id                String          @id @default(cuid())
  primeContractorId String
  name              String
  contract          String?
  project           String?
  market            String?
  region            String?
  effectiveDate     DateTime?
  expirationDate    DateTime?
  version           Int             @default(1)
  status            PriceBookStatus @default(DRAFT)
  notes             String?
  createdById       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  primeContractor   PrimeContractor @relation(fields: [primeContractorId], references: [id], onDelete: Cascade)
  lines             PriceLine[]
  imports           PriceImport[]

  @@index([primeContractorId])
  @@index([status])
}

model PriceLine {
  id          String    @id @default(cuid())
  priceBookId String
  jobCode     String
  description String
  unit        String
  ratePerUnit Int       // cents per unit; what the prime pays us
  category    String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  priceBook   PriceBook @relation(fields: [priceBookId], references: [id], onDelete: Cascade)

  @@unique([priceBookId, jobCode])
  @@index([jobCode])
}

// A price import is an auditable record of an uploaded rate sheet. Nothing
// becomes active until APPROVE IMPORT. Stores the original upload, original
// values, AI-suggested mapping, final (human) mapping, approver, and timestamp.
model PriceImport {
  id                String            @id @default(cuid())
  primeContractorId String
  priceBookId       String?
  originalFilename  String
  storagePath       String?
  fileType          String?
  status            PriceImportStatus @default(PENDING)
  usedAi            Boolean           @default(false)
  aiMapping         Json?
  finalMapping      Json?
  parsedRows        Json?
  summary           Json?
  errorRows         Json?
  createdById       String?
  approvedById      String?
  approvedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  primeContractor   PrimeContractor   @relation(fields: [primeContractorId], references: [id], onDelete: Cascade)
  priceBook         PriceBook?        @relation(fields: [priceBookId], references: [id], onDelete: SetNull)

  @@index([primeContractorId])
  @@index([status])
}

// What WE PAY a specific subcontractor per job code. Versioned; separate from
// prime billing rates. Different subcontractors can have different rates for the
// same job code.
model SubcontractorRate {
  id             String     @id @default(cuid())
  workerId       String
  jobCode        String
  description    String?
  unit           String?
  ratePerUnit    Int        // cents per unit; what we pay this subcontractor
  version        Int        @default(1)
  effectiveDate  DateTime?
  expirationDate DateTime?
  status         RateStatus @default(ACTIVE)
  notes          String?
  createdById    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  worker         Worker     @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@index([jobCode])
}

// Internal production cost for our own crews per job code. Versioned; never
// exported to a prime contractor.
model InHouseRate {
  id             String     @id @default(cuid())
  jobCode        String
  description    String?
  unit           String?
  ratePerUnit    Int        // cents per unit; internal cost
  version        Int        @default(1)
  effectiveDate  DateTime?
  expirationDate DateTime?
  status         RateStatus @default(ACTIVE)
  notes          String?
  createdById    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([jobCode])
}

enum SalespersonStatus {
  ACTIVE
  INACTIVE
}

enum CommissionPlanType {
  PERCENT_REVENUE
  PERCENT_GROSS_PROFIT
  FLAT_PER_JOB
  FLAT_PER_TASK
  PRODUCTION_RATE
  TIERED
}

enum CommissionEarnedEvent {
  JOB_COMPLETED
  JOB_APPROVED
  INVOICE_GENERATED
  INVOICE_PAID
}

enum CommissionPlanStatus {
  ACTIVE
  ARCHIVED
}

enum CommissionRecordStatus {
  PENDING
  EARNED
  PAID
  VOID
}

model Salesperson {
  id        String            @id @default(cuid())
  name      String
  email     String?
  phone     String?
  userId    String?           @unique
  status    SalespersonStatus @default(ACTIVE)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  jobs      Job[]
  commissionRecords CommissionRecord[]

  @@index([status])
}

model CommissionPlan {
  id           String                @id @default(cuid())
  name         String
  planType     CommissionPlanType
  earnedEvent  CommissionEarnedEvent @default(INVOICE_PAID)
  config       Json                  @default("{}") // rate/percent/tiers/prime & task overrides
  status       CommissionPlanStatus  @default(ACTIVE)
  version      Int                   @default(1)
  notes        String?
  createdById  String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  jobs         Job[]
  commissionRecords CommissionRecord[]

  @@index([status])
}

model CommissionRecord {
  id               String                 @id @default(cuid())
  jobId            String
  salespersonId    String
  planId           String?
  planName         String                 // snapshot of plan name at calc time
  planType         CommissionPlanType     // snapshot
  earnedEvent      CommissionEarnedEvent  // snapshot
  rateSnapshot     Json                   @default("{}") // full plan config at calc time
  basisAmount      Int                    @default(0) // cents (revenue or gross profit basis)
  commissionAmount Int                    @default(0) // cents
  status           CommissionRecordStatus @default(PENDING)
  notes            String?
  calculatedAt     DateTime               @default(now())
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  job              Job                    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  salesperson      Salesperson            @relation(fields: [salespersonId], references: [id])
  plan             CommissionPlan?        @relation(fields: [planId], references: [id])

  @@index([jobId])
  @@index([salespersonId])
  @@index([status])
}

// ============================================================
// Workstream M — IPPay payment connector (v1.2.0)
// ============================================================
enum PaymentEnvironment {
  SANDBOX
  PRODUCTION
}

enum PaymentProviderType {
  IPPAY
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  DECLINED
  VOIDED
  REFUNDED
  FAILED
}

enum PaymentMethodType {
  CARD
  ACH
}

// Singleton payment-provider configuration. Secrets are encrypted at rest and
// never returned to the browser or logged.
model PaymentSettings {
  id                    String              @id @default("default")
  provider              PaymentProviderType @default(IPPAY)
  enabled               Boolean             @default(false)
  environment           PaymentEnvironment  @default(SANDBOX)
  merchantId            String?
  terminalId            String?
  apiUsernameEncrypted  String?
  apiPasswordEncrypted  String?
  cardEnabled           Boolean             @default(true)
  achEnabled            Boolean             @default(false)
  tokenizationEnabled   Boolean             @default(false)
  lastSuccessAt         DateTime?
  lastFailureAt         DateTime?
  lastFailureMessage    String?
  lastConnectionStatus  String? // OK | FAILED | UNTESTED
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

// A single financial transaction against the payment provider.
// Writes are idempotent via the unique idempotencyKey.
model Payment {
  id                    String              @id @default(cuid())
  invoiceId             String?
  primeContractorId     String?
  amount                Int                 @default(0) // cents
  currency              String              @default("USD")
  status                PaymentStatus       @default(PENDING)
  provider              PaymentProviderType @default(IPPAY)
  environment           PaymentEnvironment  @default(SANDBOX)
  methodType            PaymentMethodType   @default(CARD)
  providerTransactionId String? // original provider TransactionID
  providerReferenceId   String? // Approval / reference code
  actionCode            String?
  responseText          String?
  cardLast4             String?
  idempotencyKey        String              @unique
  requestId             String?
  errorMessage          String?
  createdById           String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  invoice               Invoice?            @relation(fields: [invoiceId], references: [id])
  primeContractor       PrimeContractor?    @relation(fields: [primeContractorId], references: [id])

  @@index([invoiceId])
  @@index([primeContractorId])
  @@index([status])
}

// Tokenized payment method (where the provider supports tokenization).
model PaymentMethod {
  id                String            @id @default(cuid())
  primeContractorId String
  provider          PaymentProviderType @default(IPPAY)
  token             String
  methodType        PaymentMethodType @default(CARD)
  cardLast4         String?
  cardBrand         String?
  expMonth          Int?
  expYear           Int?
  isDefault         Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  primeContractor   PrimeContractor   @relation(fields: [primeContractorId], references: [id], onDelete: Cascade)

  @@index([primeContractorId])
}

// ============================================================
// Workstream W — API foundation / key management (v1.2.0)
// ============================================================
enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

// API key for /api/v1access. The plaintext key is shown ONCE at creation and
// only its SHA-256 hash is stored.
model ApiKey {
  id          String       @id @default(cuid())
  name        String
  keyPrefix   String // first chars for identification (e.g. os1_live_ab12)
  keyHash     String       @unique // sha256 of the full key
  scopes      String[]     @default([])
  status      ApiKeyStatus @default(ACTIVE)
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  lastUsedIp  String?
  createdById String?
  createdAt   DateTime     @default(now())
  revokedAt   DateTime?

  @@index([status])
}

// Idempotency ledger for API financial writes (Idempotency-Key header).
model ApiIdempotencyKey {
  id           String   @id @default(cuid())
  key          String   @unique
  method       String
  path         String
  statusCode   Int?
  responseBody Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// ============================================================================
// Increment 8 — Live Operations Map + Fleet Telematics (Geotab)
// Provider-agnostic fleet/location model. Every location record carries its
// source so mobile-worker GPS and vehicle GPS are never silently merged.
// ============================================================================

enum LocationSource {
  MOBILE_APP
  GEOTAB
  JOB_SITE
  MANUAL
  OTHER_FLEET_PROVIDER
}

enum FleetProviderType {
  GEOTAB
}

enum VehicleMotion {
  DRIVING
  STOPPED
  UNKNOWN
}

enum GeoEventType {
  WORKER_ARRIVED
  WORKER_LEFT
  VEHICLE_ARRIVED
  VEHICLE_LEFT
}

enum GeoActorType {
  WORKER
  VEHICLE
}

// A dispatchable crew (in-house or subcontractor). Workers and vehicles can be
// assigned to a crew for operational visibility on the Live Map.
model Crew {
  id                   String        @id @default(cuid())
  name                 String
  subcontractorCompany String?
  notes                String?
  active               Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  members              Worker[]
  vehicles             FleetVehicle[]
  geoEvents            GeoEvent[]
  evidencePackages     FieldEvidencePackage[]

  @@index([active])
}

// Singleton fleet-provider (Geotab) configuration. Credentials are encrypted at
// rest, never returned to the browser, and never written to logs.
model FleetProviderSettings {
  id                    String            @id @default("default")
  provider              FleetProviderType @default(GEOTAB)
  enabled               Boolean           @default(false)
  syncEnabled           Boolean           @default(false)
  database              String? // Geotab company/database
  username              String? // Geotab API identity (not secret)
  credentialEncrypted   String? // Geotab password/credential (encrypted at rest)
  sessionIdEncrypted    String? // cached Geotab session token (encrypted at rest)
  serverUrl             String? // resolved Geotab server (e.g. myXXXX.geotab.com)
  lastSuccessAt         DateTime?
  lastFailureAt         DateTime?
  lastSyncError         String?
  lastConnectionStatus  String? // OK | FAILED | UNTESTED
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
}

// Persisted feed checkpoints so continuous synchronization can resume without
// starting over or duplicating historical records (Geotab GetFeed fromVersion).
model FleetFeedState {
  id           String            @id @default(cuid())
  provider     FleetProviderType @default(GEOTAB)
  dataType     String // e.g. DeviceStatusInfo | LogRecord | Trip
  fromVersion  String?
  lastSyncAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([provider, dataType])
}

// Normalized fleet vehicle. geotabDeviceId ties it to the provider device.
model FleetVehicle {
  id                   String            @id @default(cuid())
  provider             FleetProviderType @default(GEOTAB)
  geotabDeviceId       String?
  name                 String
  vehicleNumber        String?
  vin                  String?
  make                 String?
  model                String?
  year                 Int?
  licensePlate         String?
  active               Boolean           @default(true)
  assignedCrewId       String?
  assignedWorkerId     String?
  subcontractorCompany String?
  currentJobId         String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  crew                 Crew?             @relation(fields: [assignedCrewId], references: [id])
  worker               Worker?           @relation(fields: [assignedWorkerId], references: [id])
  currentJob           Job?              @relation(fields: [currentJobId], references: [id])
  state                VehicleState?
  telemetry            VehicleTelemetry[]
  trips                VehicleTrip[]
  geoEvents            GeoEvent[]

  @@unique([provider, geotabDeviceId])
  @@index([active])
  @@index([assignedCrewId])
  @@index([currentJobId])
}

// Latest known state of a vehicle (one row per vehicle).
model VehicleState {
  id                String        @id @default(cuid())
  vehicleId         String        @unique
  latitude          Float
  longitude         Float
  recordedAt        DateTime
  speed             Float? // mph
  bearing           Float? // degrees
  motion            VehicleMotion @default(UNKNOWN)
  communicating     Boolean       @default(true)
  currentDriverName String?
  currentJobId      String?
  lastUpdateAt      DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  vehicle           FleetVehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

// Historical vehicle telemetry (authorized logistics review). Deduplicated on
// (vehicleId, providerRef) so re-synced feed records are never double-stored.
model VehicleTelemetry {
  id          String         @id @default(cuid())
  vehicleId   String
  source      LocationSource @default(GEOTAB)
  recordedAt  DateTime
  latitude    Float
  longitude   Float
  speed       Float?
  bearing     Float?
  driverName  String?
  jobId       String?
  crewId      String?
  providerRef String? // provider event/record id
  createdAt   DateTime       @default(now())
  vehicle     FleetVehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  job         Job?           @relation(fields: [jobId], references: [id])

  @@unique([vehicleId, providerRef])
  @@index([vehicleId, recordedAt])
  @@index([jobId])
}

// Trip / logistics rollups where authorized Geotab data is available.
model VehicleTrip {
  id             String       @id @default(cuid())
  vehicleId      String
  source         LocationSource @default(GEOTAB)
  startAt        DateTime
  endAt          DateTime?
  startLat       Float?
  startLng       Float?
  endLat         Float?
  endLng         Float?
  distanceMeters Float?
  drivingSeconds Int?
  odometerMeters Float?
  engineHours    Float?
  providerRef    String?
  createdAt      DateTime     @default(now())
  vehicle        FleetVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, providerRef])
  @@index([vehicleId, startAt])
}

// Continuous mobile-worker GPS stream (distinct from ActivityLog evidence GPS).
model WorkerLocation {
  id          String         @id @default(cuid())
  workerId    String
  source      LocationSource @default(MOBILE_APP)
  latitude    Float
  longitude   Float
  recordedAt  DateTime
  accuracy    Float?
  jobId       String?
  createdAt   DateTime       @default(now())
  worker      Worker         @relation(fields: [workerId], references: [id], onDelete: Cascade)
  job         Job?           @relation(fields: [jobId], references: [id])

  @@index([workerId, recordedAt])
  @@index([jobId])
}

// Geofence arrival/departure events. WORKER_* and VEHICLE_* are distinct types
// so OS1 can answer "when did the crew arrive" vs "when did the truck arrive".
model GeoEvent {
  id          String         @id @default(cuid())
  eventType   GeoEventType
  actorType   GeoActorType
  jobId       String
  workerId    String?
  vehicleId   String?
  crewId      String?
  latitude    Float?
  longitude   Float?
  occurredAt  DateTime
  source      LocationSource
  providerRef String?
  createdAt   DateTime       @default(now())
  job         Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker      Worker?        @relation(fields: [workerId], references: [id])
  vehicle     FleetVehicle?  @relation(fields: [vehicleId], references: [id])
  crew        Crew?          @relation(fields: [crewId], references: [id])

  @@index([jobId, occurredAt])
  @@index([vehicleId, occurredAt])
  @@index([workerId, occurredAt])
}

// ============================================================================
// Increment 9 (v1.2.0): System Update Center + GitHub release packages + safe install
// Workstreams S / T / U. All additive.
// ============================================================================

enum ReleaseChannel {
  STABLE
  RC
  BETA
}

enum UpdateAction {
  CHECK
  DOWNLOAD
  INSTALL
  ROLLBACK
  UPLOAD
  RETRY
}

enum UpdateResult {
  PENDING
  IN_PROGRESS
  SUCCESS
  FAILED
  ROLLED_BACK
}

enum UpdateSource {
  GITHUB
  MANUAL
}

model UpdateSettings {
  id                     String         @id @default("default")
  releaseChannel         ReleaseChannel @default(RC)
  githubOwner            String? // GitHub org/user (source of truth)
  githubRepo             String? // GitHub repository name (supports PRIVATE repos)
  githubTokenEncrypted   String? // PAT for private release access (encrypted at rest)
  autoCheck              Boolean        @default(false)
  publicKeyPem           String? // PEM public key for package signature verification
  requireSignature       Boolean        @default(false)
  maintenanceMode        Boolean        @default(false)
  latestVersion          String?
  latestReleaseAt        DateTime?
  latestCommit           String?
  latestPackageBytes     Int?
  latestReleaseNotes     String?
  latestAssetName        String?
  latestAssetSha256      String?
  lastCheckAt            DateTime?
  lastCheckStatus        String? // OK | FAILED | UNTESTED
  lastCheckError         String?
  lastSuccessfulUpdateAt DateTime?
  lastFailedUpdateAt     DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
}

model UpdateHistory {
  id             String       @id @default(cuid())
  action         UpdateAction
  source         UpdateSource @default(GITHUB)
  fromVersion    String?
  toVersion      String?
  commit         String?
  result         UpdateResult @default(PENDING)
  rollbackResult String?
  installedBy    String? // user email who initiated
  message        String?
  logs           String? // captured step-by-step log output
  startedAt      DateTime     @default(now())
  finishedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([action, createdAt])
  @@index([result])
}

// ============================================================================
// Increment 10 — Workstreams P/Q/R: Mobile app foundation, offline sync ledger,
// and permanent Field Evidence Package. All additive. The server remains
// authoritative; mobile clients consume the official API and never duplicate
// financial/business rules.
// ============================================================================

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

enum DeviceStatus {
  ACTIVE
  REVOKED
}

// A registered mobile device (P — Device Management). A worker may have several
// devices; each can be revoked independently (kills its sessions too).
model MobileDevice {
  id           String         @id @default(cuid())
  deviceUuid   String         @unique // stable client-generated device identifier
  workerId     String?
  worker       Worker?        @relation(fields: [workerId], references: [id])
  userId       String?
  user         User?          @relation(fields: [userId], references: [id])
  platform     DevicePlatform @default(ANDROID)
  deviceName   String?
  deviceModel  String?
  osVersion    String?
  appVersion   String?
  pushToken    String? // Expo/FCM/APNs push token (opaque; not a secret)
  status       DeviceStatus   @default(ACTIVE)
  lastSeenAt   DateTime?
  lastIp       String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  revokedAt    DateTime?
  revokedById  String?
  sessions     MobileSession[]
  syncEvents   MobileSyncEvent[]
  evidencePackages FieldEvidencePackage[]

  @@index([workerId])
  @@index([status])
}

// A device-bound session token (P — Session Revocation). Only the SHA-256 hash
// of the token is stored; the plaintext is returned to the device once at login.
model MobileSession {
  id           String        @id @default(cuid())
  tokenHash    String        @unique
  deviceId     String
  device       MobileDevice  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  workerId     String?
  worker       Worker?       @relation(fields: [workerId], references: [id])
  userId       String?
  user         User?         @relation(fields: [userId], references: [id])
  mfaVerified  Boolean       @default(false)
  expiresAt    DateTime
  lastUsedAt   DateTime?
  createdAt    DateTime      @default(now())
  revokedAt    DateTime?

  @@index([deviceId])
  @@index([workerId])
}

enum SyncEntityType {
  GPS
  TASK_UPDATE
  PRODUCTION
  NOTE
  EVIDENCE
  PHOTO
  DOCUMENT
  SIGNATURE
}

enum SyncResult {
  ACCEPTED
  DUPLICATE
  CONFLICT
  REJECTED
}

// Server-side ledger for offline sync (Q). Each queued client record carries a
// per-device local UUID + idempotency key; the server records the outcome so
// replays are de-duplicated and conflicts are surfaced. This is the durable
// server acknowledgment the client reconciles against.
model MobileSyncEvent {
  id             String         @id @default(cuid())
  deviceId       String?
  device         MobileDevice?  @relation(fields: [deviceId], references: [id])
  workerId       String?
  localUuid      String // client-generated UUID for the queued record
  idempotencyKey String         @unique // stable key; dedupes retries
  entityType     SyncEntityType
  result         SyncResult     @default(ACCEPTED)
  serverEntityId String? // id of the created/updated server row, when applicable
  conflictStatus String? // null | "server_newer" | "duplicate" | details
  deviceTimestamp DateTime? // when captured on device
  createdTimestamp DateTime? // when queued on device
  retryCount     Int            @default(0)
  lastError      String?
  createdAt      DateTime       @default(now())

  @@unique([deviceId, localUuid])
  @@index([workerId])
  @@index([entityType])
}

enum GeofenceStatus {
  INSIDE
  OUTSIDE
  UNKNOWN
  NO_GEOFENCE
}

enum EvidenceKind {
  PHOTO
  DOCUMENT
}

enum EvidenceStatus {
  SUBMITTED
  ACCEPTED
  FLAGGED
}

// Permanent Field Evidence Package (R). Captured when field work is submitted;
// preserves the full completion context. Treated as immutable evidence once
// ACCEPTED — never edited or deleted (status may be FLAGGED for review).
model FieldEvidencePackage {
  id                 String          @id @default(cuid())
  localUuid          String          @unique // client UUID; idempotent submission
  jobId              String
  job                Job             @relation(fields: [jobId], references: [id])
  taskId             String?
  task               Task?           @relation(fields: [taskId], references: [id])
  workerId           String?
  worker             Worker?         @relation(fields: [workerId], references: [id])
  crewId             String?
  crew               Crew?           @relation(fields: [crewId], references: [id])
  subcontractorName  String? // denormalized subcontractor company at time of work
  deviceId           String?
  device             MobileDevice?   @relation(fields: [deviceId], references: [id])
  latitude           Float?
  longitude          Float?
  gpsAccuracyMeters  Float?
  geofenceStatus     GeofenceStatus  @default(UNKNOWN)
  geofenceDistanceFeet Float?
  productionQuantity Float?
  productionUnit     String?
  notes              String?
  signatureStoragePath String?
  signatureContentType String?
  signedByName       String?
  capturedAt         DateTime? // device timestamp of completion
  submittedAt        DateTime        @default(now()) // server receipt
  status             EvidenceStatus  @default(SUBMITTED)
  assets             EvidenceAsset[]
  createdAt          DateTime        @default(now())

  @@index([jobId])
  @@index([taskId])
  @@index([workerId])
  @@index([status])
}

// A photo or document attached to a Field Evidence Package (R). Binary lives in
// cloud storage; only the storage path + metadata are stored here.
model EvidenceAsset {
  id                String               @id @default(cuid())
  packageId         String
  package           FieldEvidencePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  localUuid         String               @unique // client UUID; idempotent upload
  kind              EvidenceKind         @default(PHOTO)
  cloudStoragePath  String
  contentType       String?
  fileName          String?
  sizeBytes         Int?
  latitude          Float?
  longitude         Float?
  capturedAt        DateTime?
  createdAt         DateTime             @default(now())

  @@index([packageId])
}
