generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/fibertrack_pro/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PROJECT_MANAGER
  FIELD_WORKER
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
  LOCKED
}

enum JobStatus {
  DRAFT
  ACTIVE
  IN_PROGRESS
  UNDER_REVIEW
  APPROVED
  INVOICED
  CLOSED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
}

enum ActivityType {
  PHOTO
  DOCUMENT
  NOTE
  STATUS_UPDATE
  CHECK_IN
}

enum WorkerType {
  SUBCONTRACTOR
  IN_HOUSE
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  passwordHash   String
  role           UserRole  @default(FIELD_WORKER)
  status              UserStatus @default(ACTIVE)
  forcePasswordChange Boolean    @default(false)
  tokenVersion        Int        @default(0)
  deactivatedAt       DateTime?
  lastLoginAt         DateTime?
  mfaEnabled          Boolean    @default(false)
  mfaSecret           String?
  mfaEnrolledAt       DateTime?
  mfaLastVerifiedAt   DateTime?
  workerId       String?   @unique
  worker         Worker?   @relation(fields: [workerId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  accounts       Account[]
  sessions       Session[]
  mfaRecoveryCodes MfaRecoveryCode[]

  @@index([email])
  @@index([status])
}

model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model MfaPolicy {
  role      UserRole @id
  required  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PrimeContractor {
  id           String   @id @default(cuid())
  companyName  String
  contactName  String?
  email        String?
  phone        String?
  address      String?
  city         String?
  state        String?
  zip          String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  rateCards    PrimeContractorRate[]
  jobs         Job[]
  invoices     Invoice[]
}

model TaskType {
  id            String   @id @default(cuid())
  name          String   @unique
  description   String?
  unitOfMeasure String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  primeRates    PrimeContractorRate[]
  workerRates   WorkerRate[]
  tasks         Task[]
}

model PrimeContractorRate {
  id                String          @id @default(cuid())
  primeContractorId String
  taskTypeId        String
  ratePerUnit       Int             // cents
  primeContractor   PrimeContractor @relation(fields: [primeContractorId], references: [id], onDelete: Cascade)
  taskType          TaskType        @relation(fields: [taskTypeId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([primeContractorId, taskTypeId])
}

model Worker {
  id           String     @id @default(cuid())
  name         String
  workerType   WorkerType
  email        String?
  phone        String?
  companyName  String?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User?
  rates        WorkerRate[]
  tasks        Task[]
  activityLogs ActivityLog[]
  payoutRecords PayoutRecord[]
}

model WorkerRate {
  id          String   @id @default(cuid())
  workerId    String
  taskTypeId  String
  ratePerUnit Int      // cents
  worker      Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  taskType    TaskType @relation(fields: [taskTypeId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workerId, taskTypeId])
}

model Job {
  id                String          @id @default(cuid())
  jobNumber         String          @unique
  jobName           String
  primeContractorId String
  address           String?
  city              String?
  state             String?
  zip               String?
  latitude          Float?
  longitude         Float?
  startDate         DateTime?
  dueDate           DateTime?
  status            JobStatus       @default(DRAFT)
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  primeContractor   PrimeContractor @relation(fields: [primeContractorId], references: [id])
  tasks             Task[]
  activityLogs      ActivityLog[]

  @@index([status])
  @@index([primeContractorId])
}

model Task {
  id              String     @id @default(cuid())
  jobId           String
  taskTypeId      String
  description     String?
  quantity        Float      @default(0)
  billingRate     Int        @default(0) // cents per unit
  workerPayoutRate Int       @default(0) // cents per unit
  workerId        String?
  status          TaskStatus @default(PENDING)
  billableAmount  Int        @default(0) // cents
  costAmount      Int        @default(0) // cents
  profitAmount    Int        @default(0) // cents
  invoiceItemId   String?
  payoutRecordId  String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  job             Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  taskType        TaskType   @relation(fields: [taskTypeId], references: [id])
  worker          Worker?    @relation(fields: [workerId], references: [id])
  invoiceItem     InvoiceItem? @relation(fields: [invoiceItemId], references: [id])
  payoutRecord    PayoutRecord? @relation(fields: [payoutRecordId], references: [id])
  activityLogs    ActivityLog[]

  @@index([jobId])
  @@index([workerId])
  @@index([status])
}

model ActivityLog {
  id               String       @id @default(cuid())
  jobId            String?
  taskId           String?
  workerId         String?
  activityType     ActivityType
  description      String?
  cloudStoragePath String?
  isPublic         Boolean      @default(false)
  contentType      String?
  fileName         String?
  latitude         Float?
  longitude        Float?
  gpsAccuracy      Float?
  distanceFromJob  Float?       // in feet
  proximityWarning Boolean      @default(false)
  createdAt        DateTime     @default(now())
  job              Job?         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  task             Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  worker           Worker?      @relation(fields: [workerId], references: [id])

  @@index([jobId])
  @@index([taskId])
  @@index([workerId])
  @@index([createdAt])
}

model Invoice {
  id                String          @id @default(cuid())
  invoiceNumber     String          @unique
  primeContractorId String
  subtotal          Int             @default(0) // cents
  taxRate           Float           @default(0)
  taxAmount         Int             @default(0) // cents
  total             Int             @default(0) // cents
  status            InvoiceStatus   @default(DRAFT)
  notes             String?
  lastEmailedAt     DateTime?
  emailCount        Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  primeContractor   PrimeContractor @relation(fields: [primeContractorId], references: [id])
  items             InvoiceItem[]

  @@index([primeContractorId])
  @@index([status])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float
  unitPrice   Int     // cents
  amount      Int     // cents
  jobId       String?
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tasks       Task[]
}

model PayoutRecord {
  id         String       @id @default(cuid())
  workerId   String
  totalAmount Int         @default(0) // cents
  status     PayoutStatus @default(PENDING)
  notes      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  worker     Worker       @relation(fields: [workerId], references: [id])
  tasks      Task[]

  @@index([workerId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Phase 1 (v1.1.0) foundations: branding, email, email templates/logs, audit.
// All tables are additive; no existing model semantics change.
// ---------------------------------------------------------------------------

// Single-company branding / white-label profile (singleton row id = "default").
// Multi-tenant branding is intentionally deferred; this model can later gain a
// tenantId without altering existing columns.
model CompanyProfile {
  id            String   @id @default("default")
  companyName   String   @default("OS1 Fiber Track Pro")
  legalName     String?
  tagline       String?  @default("Fiber Construction Services")
  logoUrl       String?
  address       String?
  city          String?
  state         String?
  zip           String?
  phone         String?
  email         String?
  website       String?
  supportEmail  String?
  supportPhone  String?
  primaryColor  String   @default("#1e40af")
  accentColor   String   @default("#0891b2")
  invoicePrefix String?  @default("INV")
  invoiceFooter String?  @default("Thank you for your business")
  portalUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// SMTP / email provider configuration (singleton row id = "default").
// The SMTP password is stored ONLY as AES-256-GCM ciphertext produced with
// APP_ENCRYPTION_KEY. There is no plaintext fallback; if the key is missing or
// wrong, decryption fails closed and email sending is disabled.
model EmailSettings {
  id                String   @id @default("default")
  enabled           Boolean  @default(false)
  host              String?
  port              Int?     @default(587)
  secure            Boolean  @default(false)
  username          String?
  passwordEncrypted String?
  fromName          String?
  fromEmail         String?
  replyTo           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Editable email templates. Bodies use an allow-listed {{variable}} syntax only;
// no arbitrary code execution is possible during rendering.
model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  subject   String
  bodyHtml  String
  bodyText  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Delivery log for every outbound email attempt.
model EmailLog {
  id          String      @id @default(cuid())
  toAddress   String
  ccAddress   String?
  subject     String
  templateKey String?
  status      EmailStatus @default(QUEUED)
  error       String?
  provider    String?
  messageId   String?
  relatedType String?
  relatedId   String?
  sentById    String?
  createdAt   DateTime    @default(now())
  sentAt      DateTime?

  @@index([relatedType, relatedId])
  @@index([status])
  @@index([createdAt])
}

// General-purpose audit trail for privileged/config actions (branding, email
// settings, invoice sends, etc.). Distinct from ActivityLog, which records field
// work (photos, notes, GPS). Expanded in Phase 2 for user lifecycle & MFA.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  actorRole  String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}
